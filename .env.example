# Wisprno configuration. Copy to .env and fill in. Never commit .env.

# Optional archive and chart. Not required by npm run check.
TIGER_DATABASE_URL=

# --- System under test (voice_agent_mock) ---
TARGET_URL=http://127.0.0.1:4310
# The mock's ADMIN_TOKEN. Paste it here yourself; Wisprno never reads the mock's own .env.
TARGET_ADMIN_TOKEN=

# --- Model provider keys (only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Model roles: <provider>:<model>. provider is openai | anthropic | gemini ---
# Tester agent (simulated adversarial caller) used during the fix loop.
TESTER_MODEL=openai:gpt-4.1-mini
# Simulated legitimate caller for the normal-call suite.
CALLER_MODEL=openai:gpt-4.1-mini
# Fixer agent (proposes prompt edits or rule sets).
FIXER_MODEL=openai:gpt-4.1
# Disclosure judge. Must differ from TESTER_MODEL (different model, ideally a different vendor).
JUDGE_MODEL=anthropic:claude-sonnet-5-5
# Final-exam tester (never used during tuning). Prefer a different vendor if a key is available.
EXAM_TESTER_MODEL=anthropic:claude-haiku-5-5

# --- Run limits ---
# Concurrent sessions against the mock.
CONCURRENCY=6
# Hard stop on target-model requests per strategy (counted from evidence). Ask before raising.
TARGET_REQUEST_CAP=20000

# --- Optional prices for cost estimates, USD per 1M tokens: <input>,<output> ---
TARGET_PRICE_PER_MTOK=
TESTER_PRICE_PER_MTOK=
