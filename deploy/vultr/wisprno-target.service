[Unit]
Description=Wisprno owned synthetic target
After=network-online.target
Wants=network-online.target
[Service]
User=wisprno-target
Group=wisprno-target
WorkingDirectory=/opt/wisprno-target/current
EnvironmentFile=/etc/wisprno/target.env
ExecStart=/opt/node/bin/node src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wisprno-target
[Install]
WantedBy=multi-user.target
