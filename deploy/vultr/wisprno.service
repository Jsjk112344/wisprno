[Unit]
Description=Wisprno investigation UI
After=network-online.target wisprno-target.service
Wants=network-online.target
[Service]
User=wisprno
Group=wisprno
WorkingDirectory=/opt/wisprno/current
EnvironmentFile=/etc/wisprno/harness.env
ExecStart=/opt/node/bin/node src/runner/cli.ts ui --port 4323
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wisprno
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
